<UserManager xmlns:svns="http://org.wso2.securevault/configuration">
    <Realm>
        <Configuration>
            <AddAdmin>{{super_admin.create_admin_account}}</AddAdmin>
            <AdminRole>{{super_admin.admin_role}}</AdminRole>
            <AllowedLoginRoles>{{console_access.allowed_roles}}</AllowedLoginRoles>
            <AdminUser>
                <UserName>{{super_admin.username}}</UserName>
                <Password>{{super_admin.password}}</Password>
            </AdminUser>
            <EveryOneRoleName>everyone</EveryOneRoleName>

            {% for property_name,property_value in realm_manager.properties.items() %}
            <Property name="{{property_name}}">{{property_value}}</Property>
            {% endfor %}
            <Property name="dataSource">jdbc/{{realm_manager.data_source}}</Property>
        </Configuration>

        {% if internal_apis.file_user_store.enable %}
        <FileUserStore enabled="true">
            <users>
                {% for user in internal_apis.users %}
                <user>
                    <username>{{user.user.name}}</username>
                    <password>{{user.user.password}}</password>
                    <isAdmin>{{user.user.is_admin | default(false) }}</isAdmin>
                </user>
                {% endfor %}
            </users>
        </FileUserStore>
        {% endif %}

        {% if user_store.class is defined %}
        <UserStoreManager class="{{user_store.class}}">
            {% for property_name,property_value in user_store.properties.items() %}
            <Property name="{{property_name}}">{{property_value}}</Property>
            {% endfor %}
            {% if user_store.class == 'org.wso2.dashboard.security.user.core.jdbc.JDBCUserStoreManager' %}
            {% for property_name, property_value in user_store.pool_options.items() %}
            <Property name="{{property_name}}">{{property_value}}</Property>
            {% endfor %}
            {% endif %}
        </UserStoreManager>
        {% endif %}

        {% set secondary_property_name_map = {
            'domain_name': 'DomainName',
            'read_groups': 'ReadGroups',
            'username': 'userName',
            'password': 'password',
            'driver_name': 'driverName',
            'max_active': 'maxActive',
            'max_wait': 'maxWait',
            'connection_url': 'ConnectionURL',
            'connection_name': 'ConnectionName',
            'connection_password': 'ConnectionPassword',
            'user_search_base': 'UserSearchBase',
            'user_name_attribute': 'UserNameAttribute',
            'user_name_search_filter': 'UserNameSearchFilter',
            'user_name_list_filter': 'UserNameListFilter',
            'group_search_base': 'GroupSearchBase',
            'group_name_attribute': 'GroupNameAttribute',
            'group_name_search_filter': 'GroupNameSearchFilter',
            'group_name_list_filter': 'GroupNameListFilter',
            'membership_attribute': 'MembershipAttribute',
            'write_groups': 'WriteGroups',
            'user_entry_object_class': 'UserEntryObjectClass',
            'group_entry_object_class': 'GroupEntryObjectClass',
            'empty_roles_allowed': 'EmptyRolesAllowed'
        } %}
        {% for store in secondary_user_store %}
        <UserStoreManager class="{{store.class}}">
            {% for property_name, property_value in store.items() %}
            {% if property_name != 'class' %}
            <Property name="{{secondary_property_name_map.get(property_name, property_name)}}">{{property_value}}</Property>
            {% endif %}
            {% endfor %}
        </UserStoreManager>
        {% endfor %}

        {% if authorization_manager.class is defined %}
        <AuthorizationManager class="{{authorization_manager.class}}">
            {% for property_name,property_value in authorization_manager.properties.items() %}
            <Property name="{{property_name}}">{{property_value}}</Property>
            {% endfor %}
        </AuthorizationManager>
        {% endif %}
    </Realm>
</UserManager>
